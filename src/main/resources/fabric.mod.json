{
  "schemaVersion": 1,
  "id": "guitoxaero",
  "version": "${version}",
  "name": "GuiToXaero",
  "description": "Reads home-listing GUIs into a searchable menu and Xaero waypoints.",
  "authors": [
    "midwu"
  ],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/guitoxaero/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.midwu.guitoxaero.client.GuitoxaeroClient"
    ],
    "main": [
      "me.midwu.guitoxaero.Guitoxaero"
    ]
  },
  "mixins": [
    "guitoxaero.mixins.json",
    {
      "config": "guitoxaero.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  },
  "recommends": {
    "xaerominimap": "*",
    "xaeroworldmap": "*"
  }
}