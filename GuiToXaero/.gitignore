# MacOS DS_Store files
.DS_Store

# Gradle cache folder
.gradle

# Gradle build folder
build

# IntelliJ
out/
.idea
*.iml
# mpeltonen/sbt-idea plugin
.idea_modules/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Common working directory
run

# Xaero's mods are All-Rights-Reserved - we depend on the jars locally
# for compiling against, but never commit/redistribute them.
/libs/*.jar
!/libs/.gitkeep

# Xaero's Minimap / World Map jars (all-rights-reserved, not ours to redistribute).
# Download them yourself and drop them here - see README.md.
libs/*.jar
!libs/.gitkeep
